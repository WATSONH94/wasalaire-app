# WaSalaire — variables d'environnement (copier en .env, NE PAS committer les vraies valeurs)

# --- Base de données ---
POSTGRES_DB=wasalaire
POSTGRES_PASSWORD=__mot_de_passe_superuser_fort__
WASALAIRE_DB_PASSWORD=__mot_de_passe_role_applicatif_fort__   # rôle wasalaire_app (RLS)

# --- Sécurité applicative ---
WASALAIRE_SECRET=__secret_jeton_HMAC_long_et_aleatoire__      # signe les jetons de session
WASALAIRE_ORIGINS=https://paie.mondomaine.bj                  # origines CORS autorisées (virgules) ; * = tout (dev)
WASALAIRE_DEV=0                                               # 0 = prod (OTP non renvoyé en clair) ; 1 = démo (code affiché)

# --- Pool de connexions (A-08) ---
WASALAIRE_POOL_MIN=1               # connexions maintenues
WASALAIRE_POOL_MAX=10              # connexions maximum

# --- Stockage documentaire (A-06) ---
# Défaut = stockage local (monter WASALAIRE_STORAGE_DIR sur un volume persistant).
WASALAIRE_STORAGE_DIR=/data/storage
# Pour un stockage objet S3/MinIO (prioritaire si renseigné ; requiert `pip install boto3`) :
S3_ENDPOINT=                       # ex. https://minio.mondomaine.bj (vide = AWS S3)
S3_BUCKET=                         # ex. wasalaire-prod (bucket DÉDIÉ à WaSalaire)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=                         # ex. us-east-1 (optionnel)

# --- Intégrations (laisser vide = repli sûr : export / log, aucun envoi réel) ---
FEDAPAY_SECRET_KEY=                # décaissement mobile money (MTN/Moov via FedaPay)
WHATSAPP_TOKEN=                    # WhatsApp Business (bulletins, OTP)
WHATSAPP_PHONE_ID=
SMS_API_KEY=                       # passerelle SMS (OTP, rappels)
